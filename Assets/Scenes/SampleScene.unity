  m_Name: 
  m_EditorClassIdentifier: 
  controlPanel: {fileID: 1886528246}
  tutorialPanel: {fileID: 199665386}
  titleText: {fileID: 1910341593}
  bodyText: {fileID: 274303676}
  pageText: {fileID: 53066917}
  previousButton: {fileID: 1550360851}
  nextButton: {fileID: 444668027}
  closeButton: {fileID: 1124732204}
  helpButton: {fileID: 1605832087}
  previousButtonText: {fileID: 0}
  nextButtonText: {fileID: 0}
  closeButtonText: {fileID: 0}
  englishButton: {fileID: 1583061029}
  japaneseButton: {fileID: 117194371}
  defaultLanguage: 0
  englishSciencePage:
    title: Welcome to NBODYVR
    body: 'Globular clusters are dense, ancient systems containing hundreds of thousands
      to millions of stars. In their crowded cores, black holes undergo close gravitational
      encounters. These interactions can form binaries, replace a binary member through
      an exchange, and ultimately lead to mergers.


      NBODYVR turns data from
      an N-body simulation into an interactive 3D experience. Follow the motion of
      black holes and explore MERGE and EXCHANGE events.'
    titleFontSize: 30
    bodyFontSize: 16
    visualTextFontSize: 10
    boldTerms:
    - Globular clusters
    - black holes
    - NBODYVR
    - MERGE
    - EXCHANGE
  englishControlsPage:
    title: How to Use NBODYVR
    body: "Play / Stop \u2014 Start or stop playback at the current snapshot.\n\nTimeline
      \u2014 Move to any snapshot in the simulation.\n\nEvent \u2014 Select a MERGE
      or EXCHANGE event and jump to just before it occurs.\n\nCoM / Raw \u2014 Switch
      between the center-of-mass frame and the original simulation coordinates.\n\nSpeed
      / BH Size \u2014 Adjust the playback speed and the displayed size of black
      holes.\n\nScience Mode \u2014 Show masses, velocities, and binary properties.\n\nFollow
      Mode \u2014 Select a black hole from the dropdown and view the simulation as
      if you were traveling with it."
    titleFontSize: 30
    bodyFontSize: 12
    visualTextFontSize: 16
    boldTerms:
    - Play / Stop
    - Timeline
    - Event
    - MERGE
    - EXCHANGE
    - CoM / Raw
    - Speed / BH Size
    - Science Mode
    - Follow Mode
  englishBlackHoleLegend:
    defaultBlackHole: Black hole (no event selected)
    binaryMembers: Binary members
    interloperBlackHole: Interloper black hole (EXCHANGE)
    mergerRemnant: Merger remnant (MERGE)
  englishNavigation:
    previous: Previous
    next: Next
    finish: Start Exploring
    close: Close
  japaneseSciencePage:
    title: Welcome to NBODYVR
    body: "\u7403\u72B6\u661F\u56E3\u306F\u3001\u6570\u5341\u4E07\u304B\u3089\u6570\u767E\u4E07\u500B\u306E\u661F\u304C\u5BC6\u96C6\u3059\u308B\u53E4\u3044\u5929\u4F53\u3067\u3059\u3002\u305D\u306E\u4E2D\u5FC3\u90E8\u3067\u306F\u30D6\u30E9\u30C3\u30AF\u30DB\u30FC\u30EB\u304C\u91CD\u529B\u76F8\u4E92\u4F5C\u7528\u306B\u3088\u3063\u3066\u63A5\u8FD1\u3057\u3001\u9023\u661F\u7CFB(binary)\u3092\u5F62\u6210\u3057\u305F\u308A\u3001\u305D\u306E\u76F8\u624B\u3092\u7D44\u307F\u66FF\u3048(exchange)\u305F\u308A\u3001\u6700\u7D42\u7684\u306B\u306F\u5408\u4F53(merge)\u306B\u81F3\u308B\u3053\u3068\u3082\u3042\u308A\u307E\u3059\u3002\n\nNBODYVR\u3067\u306F\u3001\u5B9F\u969B\u306EN\u4F53\u30B7\u30DF\u30E5\u30EC\u30FC\u30B7\u30E7\u30F3\u30C7\u30FC\u30BF\u3092\u30A4\u30F3\u30BF\u30E9\u30AF\u30C6\u30A3\u30D6\u306A3D\u7A7A\u9593\u3067\u53EF\u8996\u5316\u3057\u3066\u3044\u307E\u3059\u3002\u30D6\u30E9\u30C3\u30AF\u30DB\u30FC\u30EB\u306E\u904B\u52D5\u3092\u4F53\u9A13\u3057\u3001MERGE\u3084EXCHANGE\u30A4\u30D9\u30F3\u30C8\u3092\u89B3\u5BDF\u3057\u307E\u3057\u3087\u3046\u3002"
    titleFontSize: 30
    bodyFontSize: 17
    visualTextFontSize: 10
    boldTerms:
    - "\u7403\u72B6\u661F\u56E3"
    - NBODYVR
    - MERGE
    - EXCHANGE
    - "\u30D6\u30E9\u30C3\u30AF\u30DB\u30FC\u30EB"
  japaneseControlsPage:
    title: "\u64CD\u4F5C\u65B9\u6CD5"
    body: "Play / Stop \u2014 \u73FE\u5728\u306E\u30B9\u30CA\u30C3\u30D7\u30B7\u30E7\u30C3\u30C8\u304B\u3089\u518D\u751F
      / \u505C\u6B62\u3057\u307E\u3059\u3002\n\nTimeline \u2014 \u30B7\u30DF\u30E5\u30EC\u30FC\u30B7\u30E7\u30F3\u5185\u306E\u4EFB\u610F\u306E\u30B9\u30CA\u30C3\u30D7\u30B7\u30E7\u30C3\u30C8\u3078
      \u79FB\u52D5\u3057\u307E\u3059\u3002\n\nEvent \u2014 MERGE\u307E\u305F\u306FEXCHANGE\u30A4\u30D9\u30F3\u30C8\u3092\u9078\u629E\u3059\u308B\u3068\u3001
      \u305D\u306E\u30A4\u30D9\u30F3\u30C8\u304C\u767A\u751F\u3059\u308B\u76F4\u524D\u3078\u79FB\u52D5\u3057\u307E\u3059\u3002\n\nCoM
      / Raw \u2014 \u91CD\u5FC3\u5EA7\u6A19\u7CFB\u3068\u3001 \u30B7\u30DF\u30E5\u30EC\u30FC\u30B7\u30E7\u30F3\u672C\u6765\u306E\u5EA7\u6A19\u7CFB\u3092\u5207\u308A\u66FF\u3048\u307E\u3059\u3002\n\nSpeed
      / BH Size \u2014 \u518D\u751F\u901F\u5EA6\u3068\u3001\u30D6\u30E9\u30C3\u30AF\u30DB\u30FC\u30EB\u306E
      \u8868\u793A\u30B5\u30A4\u30BA\u3092\u8ABF\u6574\u3057\u307E\u3059\u3002\n\nScience
      Mode \u2014 \u30D6\u30E9\u30C3\u30AF\u30DB\u30FC\u30EB\u306E\u8CEA\u91CF\u3001\u901F\u5EA6\u3001
      \u9023\u661F\u306E\u7269\u7406\u91CF\u3092\u8868\u793A\u3057\u307E\u3059\u3002\n\nFollow
      Mode \u2014 \u30C9\u30ED\u30C3\u30D7\u30C0\u30A6\u30F3\u304B\u3089\u30D6\u30E9\u30C3\u30AF\u30DB\u30FC\u30EB\u3092
      \u9078\u629E\u3059\u308B\u3068\u3001\u305D\u306E\u30D6\u30E9\u30C3\u30AF\u30DB\u30FC\u30EB\u3068\u4E00\u7DD2\u306B\u79FB\u52D5\u3057\u3066\u3044\u308B\u3088\u3046\u306A\u8996\u70B9\u306B\u5207\u308A\u66FF\u308F\u308A\u307E\u3059\u3002"
    titleFontSize: 30
    bodyFontSize: 11
    visualTextFontSize: 15
    boldTerms:
    - Play / Stop
    - Timeline
    - Event
    - MERGE
    - EXCHANGE
    - CoM / Raw
    - Speed / BH Size
    - Science Mode
    - Follow Mode
  japaneseBlackHoleLegend:
    defaultBlackHole: "\u30A4\u30D9\u30F3\u30C8\u672A\u9078\u629E\u6642\u306EBH"
    binaryMembers: "\u9023\u661F\u306E\u30E1\u30F3\u30D0\u30FC"
    interloperBlackHole: "\u4FB5\u5165BH\uFF08EXCHANGE\uFF09"
    mergerRemnant: "\u5408\u4F53\u5F8C\u306EBH\uFF08MERGE\uFF09"
  japaneseNavigation:
    previous: "\u623B\u308B"
    next: "\u6B21\u3078"
    finish: "\u63A2\u7D22\u3092\u59CB\u3081\u308B"
    close: "\u9589\u3058\u308B"
  imageCredit: "M13 \u2014 NASA, ESA, and the Hubble Heritage Team (STScI/AURA)"
